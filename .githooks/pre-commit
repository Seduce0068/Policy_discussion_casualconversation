#!/bin/sh
# Regenerate OKF index files and remind about log.md before each commit.
# Enable once per clone with: git config core.hooksPath .githooks
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

script="scripts/okf-index.rs"
if [ -f "$script" ]; then
  if command -v rust-script >/dev/null 2>&1; then
    rust-script "$script"
    for path in adr/index.md chats/index.md notes/index.md reports/index.md; do
      if [ -f "$path" ]; then
        git add -- "$path"
      fi
    done
  else
    echo "pre-commit: rust-script が見つからないため索引生成をスキップします" >&2
  fi
fi

changed=$(git diff --cached --name-only)

for dir in adr chats notes reports; do
  docs=$(printf '%s\n' "$changed" \
    | grep -E "^${dir}/[^/]+\.md$" \
    | grep -vE '/(index|log)\.md$' || true)
  if [ -n "$docs" ] && ! printf '%s\n' "$changed" | grep -qx "${dir}/log.md"; then
    echo "pre-commit: ${dir}/ の文書を変更しています。${dir}/log.md への追記を検討してください。" >&2
  fi
done

ops=$(printf '%s\n' "$changed" \
  | grep -E '^(AGENTS\.md|README\.md|index\.md|scripts/|\.githooks/|\.github/|templates/)' || true)
if [ -n "$ops" ] && ! printf '%s\n' "$changed" | grep -qx 'log.md'; then
  echo "pre-commit: リポジトリ全体の変更です。log.md への追記を検討してください。" >&2
fi
